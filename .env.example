# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/provenance?schema=public"

# Authentication Secrets (Strict 256-bit keys, minimum 32 characters required)
JWT_SECRET="replace_with_a_secure_random_string_at_least_32_characters_long"
JWT_REFRESH_SECRET="replace_with_a_secure_refresh_secret_at_least_32_characters_long"

# Server Configuration
PORT=4000
CORS_ORIGIN="http://localhost:3000"

# Issuer Verification Connectors (Set to 'false' to disable all outbound lookups)
ISSUER_LOOKUP_ENABLED=true

