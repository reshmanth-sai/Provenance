# ==============================================================================
# Provenance Production Environment Template
# Duplicate this file as .env.production on your deployment server or inject
# these variables into your hosting platform (Render, Railway, Fly, Vercel, ECS).
# ==============================================================================

# Database Connection (PostgreSQL 16)
# If using Docker Compose, the database service is named 'postgres'.
# For managed databases (Supabase, Neon, AWS RDS, Render Postgres):
DATABASE_URL="postgresql://postgres:REPLACE_WITH_STRONG_DB_PASSWORD@postgres:5432/provenance?schema=public"

# Database Service (Used when deploying via docker-compose.prod.yml)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="REPLACE_WITH_STRONG_DB_PASSWORD"
POSTGRES_DB="provenance"

# Authentication Secrets (STRICT SECURITY: Minimum 32 characters required)
# Generate with: openssl rand -base64 32
JWT_SECRET="REPLACE_WITH_MINIMUM_32_CHAR_CRYPTOGRAPHIC_SECRET_KEY_FOR_ACCESS"
JWT_REFRESH_SECRET="REPLACE_WITH_MINIMUM_32_CHAR_CRYPTOGRAPHIC_SECRET_KEY_FOR_REFRESH"

# Domain & CORS Configuration
# Set to your production public web URL (e.g., https://provenance.yourdomain.com)
FRONTEND_URL="https://provenance.yourdomain.com"
PUBLIC_BASE_URL="https://provenance.yourdomain.com"
CORS_ORIGIN="https://provenance.yourdomain.com"

# Public API URL for Frontend (Baked into client bundles at build time)
# If using Next.js /api rewrites, you can omit or set to https://provenance.yourdomain.com/api
NEXT_PUBLIC_API_URL="https://api.yourdomain.com"
NEXT_PUBLIC_SITE_URL="https://provenance.yourdomain.com"

# Server Ports
PORT=4000

# Cookie SameSite Policy ('lax' for same-domain or Next.js rewrites, 'none' for cross-domain)
# If frontend and API are on different subdomains/domains (e.g. vercel + render), use 'none'.
COOKIE_SAME_SITE="lax"

# Persistent Storage Directory
# Inside Docker container, mapped to a persistent volume
STORAGE_DIR="/app/storage/uploads"

# Outbound Public Issuer Connectors (Coursera, etc.)
# Set to 'false' if running in an air-gapped or zero-outbound environment
ISSUER_LOOKUP_ENABLED=true

# Security Incident Alerting Webhook (Optional)
# Dispatches real-time POST payloads on high-severity security incidents (Slack, Discord, PagerDuty)
# SECURITY_ALERT_WEBHOOK_URL="https://hooks.slack.com/services/YOUR/WEBHOOK/URL"

