{
  "name": "provenance",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@provenance/api",
    "dev:web": "npm run dev --workspace=@provenance/web",
    "db:migrate": "npm --workspace=@provenance/db run migrate --",
    "db:generate": "npm --workspace=@provenance/db run generate",
    "db:seed": "npm --workspace=@provenance/db run seed",
    "build": "npm run build --workspaces"
  }
}
