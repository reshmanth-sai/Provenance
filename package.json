{
  "name": "provenance",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@provenance/api",
    "dev:web": "npm run dev --workspace=@provenance/web",
    "db:migrate": "npm run db:backup && npm --workspace=@provenance/db run migrate --",
    "db:generate": "npm --workspace=@provenance/db run generate",
    "db:seed": "npm --workspace=@provenance/db run seed",
    "issuer:create": "npx tsx packages/db/src/create-issuer.ts",
    "admin:create": "npx tsx packages/db/src/create-admin.ts",
    "pdf:generate": "npx tsx scripts/generate-degree.ts",
    "build": "npm run build --workspaces",
    "start:api": "npm run start --workspace=@provenance/api",
    "start:web": "npm run start --workspace=@provenance/web",
    "db:deploy": "npm --workspace=@provenance/db run migrate:deploy",
    "db:backup": "bash scripts/db-backup.sh",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "gate": "bash scripts/gate.sh"
  }
}
