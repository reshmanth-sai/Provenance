datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String                @id @default(uuid())
  email             String                @unique
  passwordHash      String
  role              String                // candidate | issuer_staff | platform_admin
  createdAt         DateTime              @default(now())
  profile           CandidateProfile?
  documents         Document[]
  credentials       Credential[]
  requests          VerificationRequest[]
  eventsCreated     CredentialEvent[]
  issuerMemberships IssuerUser[]
  invitesSent       InstitutionInvite[]
  auditLogs         AuditLog[]
  approvedIssuers   Issuer[]              @relation("IssuerApprover")
  resolvedRequests  VerificationRequest[] @relation("RequestResolver")
}

model CandidateProfile {
  userId         String  @id
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicUsername String  @unique
  name           String
  headline       String?
  bio            String?
  avatarUrl      String?
}

model Issuer {
  id               String                @id @default(uuid())
  name             String
  domain           String                @unique
  status           String                @default("pending") // pending | approved | rejected
  approvedBy       String?
  approver         User?                 @relation("IssuerApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  approvedAt       DateTime?
  createdAt        DateTime              @default(now())
  members          IssuerUser[]
  credentials      Credential[]
  requests         VerificationRequest[]
  credentialEvents CredentialEvent[]
}

model IssuerUser {
  id       String @id @default(uuid())
  issuerId String
  issuer   Issuer @relation(fields: [issuerId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String @default("staff")
}

model Document {
  id                   String             @id @default(uuid())
  candidateId          String
  candidate            User               @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  storageKey           String
  originalMimeType     String
  rawFileHash          String
  canonicalContentHash String?
  metadata             Json?
  phash                String?
  ocrText              String?
  ocrConfidence        Float?
  c2paPresent          Boolean            @default(false)
  c2paManifest         Json?
  uploadedAt           DateTime           @default(now())
  analyses             DocumentAnalysis[]
  credentials          Credential[]
}

model DocumentAnalysis {
  id          String   @id @default(uuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  signalType  String
  signalValue Json
  severity    String   // low_concern | review_recommended | inconclusive
  createdAt   DateTime @default(now())
}

model Credential {
  id                   String                @id @default(uuid())
  candidateId          String
  candidate            User                  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  issuerId             String?
  issuer               Issuer?               @relation(fields: [issuerId], references: [id], onDelete: SetNull)
  documentId           String?
  document             Document?             @relation(fields: [documentId], references: [id], onDelete: SetNull)
  source               String                // self_submitted | issuer_issued
  status               String                @default("unverified") // unverified | pending | verified | rejected | revoked
  credentialType       String
  credentialTitle      String
  issueDate            DateTime?
  certificateNumber    String?
  createdAt            DateTime              @default(now())
  verificationRequests VerificationRequest[]
  credentialEvents     CredentialEvent[]
}

model VerificationRequest {
  id           String     @id @default(uuid())
  credentialId String
  credential   Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  candidateId  String
  candidate    User       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  issuerId     String
  issuer       Issuer     @relation(fields: [issuerId], references: [id], onDelete: Cascade)
  status       String     @default("pending") // pending | approved | rejected
  requestedAt  DateTime   @default(now())
  resolvedAt   DateTime?
  resolvedBy   String?
  resolver     User?      @relation("RequestResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)
}

model CredentialEvent {
  id            String     @id @default(uuid())
  credentialId  String
  credential    Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  issuerId      String
  issuer        Issuer     @relation(fields: [issuerId], references: [id], onDelete: Cascade)
  eventType     String     // issued | verified | rejected | revoked
  canonicalData Json
  contentHash   String
  prevHash      String?
  createdAt     DateTime   @default(now())
  createdBy     String
  creator       User       @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([issuerId, createdAt])
}

model InstitutionInvite {
  id              String   @id @default(uuid())
  invitedBy       String
  inviter         User     @relation(fields: [invitedBy], references: [id], onDelete: Cascade)
  institutionName String
  contactEmail    String?
  status          String   @default("sent") // sent | joined
  createdAt       DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
}
